{
  "name": "@collectbase/pack-opener",
  "version": "0.1.0",
  "description": "Interactive pack-opening animation rendered by PixiJS, for React Native and the web",
  "keywords": [
    "animation",
    "pixijs",
    "webgl",
    "react-native",
    "react",
    "trading-cards",
    "loot-box",
    "pack-opening"
  ],
  "license": "MIT",
  "author": "Collectbase",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Collectbase/pack-opener.git"
  },
  "homepage": "https://github.com/Collectbase/pack-opener#readme",
  "bugs": "https://github.com/Collectbase/pack-opener/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs",
      "default": "./dist/react.js"
    },
    "./native": {
      "types": "./dist/types/native/index.d.ts",
      "react-native": "./dist/native.js",
      "import": "./dist/native.js",
      "require": "./dist/native.cjs",
      "default": "./dist/native.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm build:scene && pnpm build:dist",
    "build:scene": "node scripts/buildScene.mjs",
    "build:dist": "node scripts/build.mjs",
    "verify:scene": "node scripts/buildScene.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "playground": "vite playground",
    "prepublishOnly": "pnpm verify:scene && pnpm typecheck && pnpm build:dist"
  },
  "peerDependencies": {
    "pixi.js": "^8",
    "react": ">=18",
    "react-native": ">=0.79",
    "react-native-reanimated": ">=3",
    "react-native-webview": ">=13"
  },
  "peerDependenciesMeta": {
    "pixi.js": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pixi.js": "^8.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
