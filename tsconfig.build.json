{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "src"
  },
  "include": ["src"],
  // The generated scene and sounds are string literals of half a megabyte
  // and more; their hand-written .d.ts next to them is what the importers
  // resolve against
  "exclude": ["src/native/sceneBundle.js", "src/core/sound/samples.js"]
}
